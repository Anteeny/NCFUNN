{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/u/(?<token>[^/]+)", "dest": "/update-profile.html" },
    { "src": "/update/(?<token>[^/]+)", "dest": "/update-profile.html" },
    { "src": "/admin", "dest": "/index.html" },
    { "src": "/update-profile", "dest": "/update-profile.html" },
    { "handle": "filesystem" }
  ]
}
